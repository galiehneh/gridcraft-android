<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GridCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#f3f3f3</item>
        <item name="android:navigationBarColor">#f3f3f3</item>
        <item name="android:statusBarColor">#107c41</item>
    </style>

    <style name="Theme.GridCraft.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.GridCraft</item>
    </style>
</resources>
